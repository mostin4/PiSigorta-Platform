interface VoteData {
  [proposalId: string]: {
    [choice: string]: number;
  };
}

interface ProcessedResult {
  proposalId: string;
  totalVotes: number;
  breakdown: {
    [choice: string]: {
      count: number;
      percentage: number;
    };
  };
}

export function processVoteResults(voteResults: VoteData): ProcessedResult[] {
  if (!voteResults || Object.keys(voteResults).length === 0) {
    return [];
  }

  return Object.entries(voteResults).map(([proposalId, votes]) => {
    const totalVotes = Object.values(votes).reduce((acc, curr) => acc + curr, 0);
    
    const breakdown = Object.entries(votes).reduce((acc, [choice, count]) => {
      acc[choice] = {
        count,
        percentage: totalVotes > 0 ? Number(((count / totalVotes) * 100).toFixed(2)) : 0
      };
      return acc;
    }, {} as ProcessedResult['breakdown']);

    return {
      proposalId,
      totalVotes,
      breakdown
    };
  });
}
