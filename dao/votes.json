import fs from 'fs';
import path from 'path';

interface VoteDetail {
  title: string;
  totalVotes: number;
  choices: Record<string, number>;
  percentages: Record<string, number>;
  ipfsCid: string;
  status: string;
  timestamp: number;
}

interface VotesDatabase {
  [proposalId: string]: VoteDetail;
}

export function loadVoteRecords(): VotesDatabase {
  try {
    const filePath = path.join(process.cwd(), 'dao', 'votes.json');
    if (!fs.existsSync(filePath)) {
      return {};
    }
    const fileData = fs.readFileSync(filePath, 'utf-8');
    return JSON.parse(fileData) as VotesDatabase;
  } catch (error: any) {
    console.error("votes.json okuma hatası:", error.message);
    return {};
  }
}

export function saveVoteRecord(proposalId: string, data: VoteDetail): boolean {
  try {
    const filePath = path.join(process.cwd(), 'dao', 'votes.json');
    const currentData = loadVoteRecords();
    
    currentData[proposalId] = data;
    
    fs.writeFileSync(filePath, JSON.stringify(currentData, null, 2), 'utf-8');
    return true;
  } catch (error: any) {
    console.error("votes.json yazma hatası:", error.message);
    return false;
  }
}
